# Ignore files in these directories but keep the directories
source/*
production_source/*
documentation/*
test_docs/*
automated_tests/

# Config file with encrypted credentials
bin/.ibmi-config.json

# Keep the directories themselves
!source/.gitkeep
!production_source/.gitkeep
!documentation/.gitkeep
!test_docs/.gitkeep

# Python bytecode
__pycache__/

# Per-user Claude Code settings (shared settings go in .claude/settings.json)
.claude/settings.local.json
